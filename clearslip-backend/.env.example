# LLM fallback (optional) — free key at https://console.groq.com
# Only used when the rule-based parser can't confidently read a payslip.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=medium
# Tried once when the main model is rate-limited or retired (own free-tier limit); empty = off
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# Longest one AI call may take (streaming included) before answers fall back to the sources, in ms
GROQ_TIMEOUT_MS=30000
# How long answers to general questions (no payslip) are cached, in ms; 0 = off
ASK_CACHE_TTL_MS=21600000

# Full AI answers one visitor can get per day; after that theirs are sources only. 0 = no cap
ASK_DAILY_AI_LIMIT=40

# Server-side OCR workers kept ready (used only when a file can't be read in the browser)
OCR_WORKERS=2

# n8n (optional) — needed only for the "Email checklist" feature
N8N_WEBHOOK_URL=http://localhost:5678/webhook/clearslip/send-checklist
N8N_SECRET=your_webhook_secret_here

# Signs decode results so "Email checklist" only sends ClearSlip's own checklists.
# Any long random string (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`).
# Leave empty locally: a random key is made at start-up.
SIGNING_SECRET=

# Error tracking (optional) — a Sentry DSN; also run `npm install @sentry/node`.
# Only 5xx faults are sent, with request bodies and user details removed.
SENTRY_DSN=

# Server
PORT=4000
FRONTEND_URL=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=20
