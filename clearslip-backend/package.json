{
  "name": "clearslip-backend",
  "version": "1.0.0",
  "description": "ClearSlip API server — OCR + rule-based payslip decoder with optional LLM fallback, n8n webhook forwarder",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "rag:index": "node scripts/buildRagIndex.js",
    "rag:eval": "node scripts/evalRag.js"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "pdf-parse": "^1.1.1",
    "tesseract.js": "^5.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {}
  }
}
